/* ===== kbAudio: เล่น mp3 + callback (ยกจาก theme_phonicsHome) ===== */
var kbCurAudio=null;
var kbAudioEl=null, kbAutoTimer=null, kbLastKey='';
function kbSay(text, cb){
  /* พูดครั้งเดียวเท่านั้น: ถ้ากำลังพูดอยู่ ให้ยกเลิกของเก่าก่อน */
  try{
    if(!window.speechSynthesis){ cb&&cb(); return; }
    if(window.__kbSayBusy){ console.log('KBWORD:tts-skip(dup)'); cb&&cb(); return; }
    window.__kbSayBusy=true;
    speechSynthesis.cancel();
    var u=new SpeechSynthesisUtterance(String(text));
    u.lang='en-US'; u.rate=0.85;
    var done=false;
    var fin=function(){ if(done)return; done=true; window.__kbSayBusy=false; cb&&cb(); };
    u.onend=fin; u.onerror=fin;
    speechSynthesis.speak(u);
    setTimeout(fin,4000);
  }catch(e){ window.__kbSayBusy=false; cb&&cb(); }
}
/* ลำดับไฟล์เสียงจริงบนเซิร์ฟเวอร์: l2/<word>.mp3 ขึ้นก่อน เพราะครบทุกคำของหลักสูตร */
function kbWordUrls(w){
  var lw=String(w||'').toLowerCase().replace(/[^a-z'\-]/g,'');
  return ['/kidobits/audio/l2/'+lw+'.mp3'];   /* แหล่งเดียว: ไม่ไล่ fallback ให้เสียงปนกัน */
}
var kbLastSpoken='', kbLastSpokenAt=0;
function kbStopAudio(){
  try{ if(kbAudioEl){ kbAudioEl.pause(); kbAudioEl.currentTime=0; kbAudioEl=null; } }catch(e){}
  try{ if(window.speechSynthesis) speechSynthesis.cancel(); }catch(e){}
}
function kbPlayWord(word, cb){
  var lw=String(word||'').toLowerCase().replace(/[^a-z'\-]/g,'');
  if(!lw){ cb&&cb(); return; }
  var now=Date.now();
  if(lw===kbLastSpoken){ console.log('KBWORD:dup-skip '+lw); cb&&cb(); return; }   /* คำเดิม → ห้ามซ้ำ */
  kbStopAudio();                      /* ตัดเสียงที่ค้างอยู่ทันที */
  window.__kbWordBusy=true; kbLastSpoken=lw; kbLastSpokenAt=now;
  var url='/kidobits/audio/l2/'+lw+'.mp3';
  var done=false;
  var fin=function(){ if(done)return; done=true; window.__kbWordBusy=false; cb&&cb(); };
  try{
    var a=new Audio(url); kbAudioEl=a;
    a.onended=fin;
    a.onerror=function(){
      console.log('KBWORD:miss '+url);
      /* ไม่มีไฟล์ → ใช้ TTS ครั้งเดียว ไม่ไล่ไฟล์อื่น */
      try{
        var u=new SpeechSynthesisUtterance(lw);
        u.lang='en-US'; u.rate=0.85;
        u.onend=fin; u.onerror=fin;
        speechSynthesis.speak(u);
        setTimeout(fin,4000);
      }catch(e){ fin(); }
    };
    var pr=a.play();
    if(pr&&pr.then){ pr.then(function(){ console.log('KBWORD:play '+url); })
                       .catch(function(){ console.log('KBWORD:blocked '+url); fin(); }); }
  }catch(e){ fin(); }
}
function kbPlay(url,cb){
  var called=false;
  var fire=function(){
    if(called) return; called=true;
    try{ if(kbCurAudio){kbCurAudio.pause();kbCurAudio.src=''} kbCurAudio=null; }catch(e){}
    if(cb){ try{cb()}catch(e){console.log('KBPLAY cb err '+e)} }
  };
  try{
    if(kbCurAudio){try{kbCurAudio.pause();kbCurAudio.src=''}catch(e){} kbCurAudio=null;}
    var a=new Audio(url); kbCurAudio=a;
    a.onended=fire;
    a.onerror=function(){console.log('KBPLAY:error '+url);fire()};
    var pr=a.play();
    if(pr&&pr.catch)pr.catch(function(e){ console.log('KBPLAY:blocked '+e.name); fire(); });
  }catch(e){ console.log('KBPLAY:throw '+e); fire(); return; }
  // fallback: ถ้า onended ไม่ยิงใน 3.5 วินาที → ไปต่อเอง
  setTimeout(fire,3500);
  console.log('KBPLAY:start '+url);
}

