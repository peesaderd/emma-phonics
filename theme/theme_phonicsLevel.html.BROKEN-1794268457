function kbReactClick(el){
  try{
    var k=Object.keys(el).find(function(x){return x.indexOf('__reactProps$')===0});
    if(!k) return false;
    var props=el[k];
    if(props && typeof props.onClick==='function'){
      props.onClick({target:el,currentTarget:el,preventDefault:function(){},stopPropagation:function(){},nativeEvent:{}});
      return true;
    }
  }catch(e){ console.log('KBREACT err '+e); }
  return false;
}
function kbPrevNextClick(){
  try{
    var bs=[].slice.call(document.querySelectorAll('button'));
    var want=[/^ต่อไป\s*→$/, /^ข้อต่อไป\s*→$/, /^ไปขั้นที่\s*5\s*→$/, /^ไปข้อถัดไป/];
    for(var w=0;w<want.length;w++){
      for(var i=0;i<bs.length;i++){
        var tx=(bs[i].innerText||'').replace(/\n/g,' ').trim();
        if(want[w].test(tx)){
          var ok=kbReactClick(bs[i]);
          console.log('KBNAV:'+(ok?'react':'dom')+' '+tx);
          if(!ok) bs[i].click();
          return true;
        }
      }
    }
    console.log('KBNAV:notfound');
  }catch(e){ console.log('KBNAV:err '+e); }
  return false;
}
