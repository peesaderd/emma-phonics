}
function kbMatchWord(clean,target){
  if(!clean||!target)return false;
  var tg=String(target).toLowerCase().trim();
  var toks=clean.split(/\s+/);
  if(toks.indexOf(tg)!==-1)return true;
  if(tg.length>=3 && clean.indexOf(tg)!==-1)return true;
  return kbSoundsLike2(clean,tg);
}
