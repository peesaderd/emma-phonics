    var sk=kbSoundKey2(toks[i]); if(!sk)continue;
    if(sk===tk)return true;
    if(tk.length>=3&&sk.length>=3&&kbLev2(sk,tk)<=1)return true;
    if(tk.length>=5&&sk.indexOf(tk.slice(0,4))===0)return true;
