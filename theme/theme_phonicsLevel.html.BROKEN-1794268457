/* ===== kbMic UI helpers + runner (ต้องอยู่ใน module เพื่อเข้าถึง kbMic/kbAutoNextStep4) ===== */
function kbSetLevel(pct){
  try{
    var ps=document.querySelectorAll('p');
    for(var i=0;i<ps.length;i++){
      var el=ps[i];
      if(el.children.length===0 && /ระดับเสียงไมค์/.test(el.textContent||'')){
        el.textContent='ระดับเสียงไมค์: '+Math.round(pct)+'%';
        var bar=el.nextElementSibling;
        if(bar&&bar.firstElementChild) bar.firstElementChild.style.width=Math.round(pct)+'%';
        return;
      }
    }
  }catch(e){}
}
function kbSetMsg(txt){
  try{
    var ps=document.querySelectorAll('p');
    for(var i=0;i<ps.length;i++){
      var el=ps[i];
      if(el.children.length===0 && /แตะไมค์เพื่อลองพูด|กำลังฟัง|ถูกต้อง|ได้ยิน|ยังไม่ตรง|ไม่ได้ยิน|ไมค์ไม่พร้อม/.test(el.textContent||'')){
        el.textContent=txt; return;
      }
    }
  }catch(e){}
}
function kbRunMic(target){
  if(kbBusy) return 'busy';
  var shown=0;
  var meter=setInterval(function(){ shown=Math.min(96,shown+4); kbSetLevel(shown); },160);
  kbSetMsg('กำลังฟัง…');
  kbMic(target, function(status,text){
    clearInterval(meter);
    console.log('KBRUN cb='+status+' text='+text);
    if(status==='pass'){
      kbSetLevel(100); kbSetMsg('ถูกต้อง! ได้ยิน "'+text+'" 🎉');
      setTimeout(function(){ kbSetMsg(''); },1200);
    }else if(status==='fail'){
      kbSetMsg('ยังไม่ตรง ลองพูดอีกครั้ง');
    }
  },300);
})();

window.__kbPlayWord = kbPlayWord;
window.__kbSaySentence = function(sent){
  var s=String(sent||'').trim();
  if(!s) return;
  try{
    kbStopAudio();
    var u=new SpeechSynthesisUtterance(s);
    u.lang='en-US'; u.rate=0.8;
    speechSynthesis.speak(u);
  }catch(e){}
};
window.__kbSay = kbSay;
window.__kbClick = kbReactClick;

document.addEventListener('click', function(ev){
  var el=ev.target;
  while(el && el!==document.body){
    if(el.tagName==='BUTTON'){
      var tx=(el.innerText||'').trim();
      if(/^[1-6]\.\s/.test(tx) || /Listening for first sounds/.test(tx)){
        if(kbAutoTimer) clearTimeout(kbAutoTimer);
        kbAutoTimer=setTimeout(function(){ window.__kbAutoOn(true); }, 700);
      }
      break;
    }
    el=el.parentElement;
  }
}, true);

window.__kbAutoOn=window.__kbAutoOn;
window.__kbNext = kbPrevNextClick;
window.__kbAutoOn = window.__kbAutoOn;
/* simpass removed */
/* ===== expose engine → classic script interceptor ===== */
window.__kbShowLevel = function(p){ try{kbSetLevel(p)}catch(e){} };
window.__kbShowMsg   = function(m){ try{kbSetMsg(m)}catch(e){} };
window.__kbRunMic    = function(target){ return kbRunMic(target); };
window.__kbAutoNext  = function(){ try{ kbAutoNextStep4() }catch(e){} };
window.__kbReady     = true;
</script>
<script>
(function(){
  if(window.__kbAudioHook) return; window.__kbAudioHook=1;
  var BASE="/theme/audio/";
  var last=null, lastKey=null, lastAt=0;
  function play(file){
    try{
      if(!file) return;
      if(last){ try{last.pause();last.currentTime=0;}catch(e){} }
      var a=new Audio(BASE+file+".mp3");
      last=a;
      a.play().catch(function(){});
    }catch(e){}
  }
  function norm(s){ return String(s||"").toLowerCase().replace(/[^a-z ]/g," ").replace(/\s+/g," ").trim(); }
  function handle(txt){
    if(!txt) return;
    var t=txt.replace(/\s+/g," ").trim();
    var m;
    // "ฟังคำนี้: mat"
    m=t.match(/ฟังคำนี้:\s*([a-zA-Z']+)/);
    if(m){ emit(m[1], "word"); return; }
    // "ฟัง: at"  (คำเดียว)
    m=t.match(/^ฟัง:\s*([a-zA-Z']{1,12})\s*(?:🔊)?$/);
    if(m){ emit(m[1], "word"); return; }
    // "ฟังประโยค: The cat sat on the mat."
    m=t.match(/ฟังประโยค:\s*(.+)$/);
    if(m){ emit(m[1], "sent"); return; }
  }
  function emit(word, kind){
    var w=norm(word);
    if(!w) return;
    var now=Date.now();
    if(lastKey===w && now-lastAt<700) return;
    lastKey=w; lastAt=now;
    if(kind==="sent"){
      play("sentence_"+w.replace(/ /g,"_"));
      return;
    }
    var chips=w.split(" ").filter(Boolean);
    if(chips.length===1){ play("word_"+chips[0]); return; }
    play("word_"+chips[0]);
  }
  var seen=new WeakMap();
  function scan(){
    var nodes=document.querySelectorAll("p,h1,h2,h3,div,span");
    for(var i=0;i<nodes.length;i++){
      var el=nodes[i];
      if(el.children && el.children.length>1) continue;
      var txt=el.textContent||"";
      if(txt.indexOf("ฟัง")===-1) continue;
      if(txt.length>120) continue;
      var prev=seen.get(el);
      if(prev===txt) continue;
      seen.set(el,txt);
      handle(txt);
    }
  }
  var obs=new MutationObserver(function(){ scan(); });
  function boot(){
    obs.observe(document.body,{childList:true,subtree:true,characterData:true});
    scan();
  }
  if(document.readyState==="loading") document.addEventListener("DOMContentLoaded",boot); else boot();
})();


</script>
<script>
/* ===== kbMicIntercept (classic scope): ดักปุ่มไมค์ → เรียก engine ใน module ===== */
(function(){
  var kbHooked=false;
  function targetWord(){
    try{
      var m=(document.body.innerText||'').match(/ลองพูด:\s*\n?\s*([a-zA-Z'\-]+)/);
      if(m) return m[1].toLowerCase();
    }catch(e){}
    return null;
  }
  function hook(){
    if(kbHooked) return;
    kbHooked=true;
    document.addEventListener('click', function(ev){
      var el=ev.target;
      while(el && el!==document.body){
        if(el.tagName==='BUTTON' && (el.innerText||'').indexOf('\uD83C\uDF99')===0){
          if(!window.__kbReady) return;          // engine ยังไม่พร้อม → ปล่อยเดิม
          var tw=targetWord();
          if(!tw) return;                         // ไม่ใช่ขั้นที่มีคำเป้าหมาย
          ev.stopImmediatePropagation();
          ev.preventDefault();
          window.__kbRunMic(tw);
          return;
        }
        el=el.parentElement;
      }
    }, true);
    setInterval(function(){ window.__kbHooked=true; }, 1000);
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',hook);
  else hook();
})();

</script>
